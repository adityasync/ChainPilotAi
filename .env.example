# ===========================================
# FlowChainAI Environment Variables
# ===========================================
# Copy this file and fill in values:
#   - Local dev: copy to backend/.env AND frontend/.env
#   - Production: set in Render (backend) and Vercel (frontend) dashboards

# === DATABASE (Neon PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === AUTH ===
SECRET_KEY=change-this-to-a-random-32-plus-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === CORS (comma-separated) ===
BACKEND_CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# === HTTPS redirect (set true on Render) ===
FORCE_HTTPS=false

# === ML ===
ML_ARTIFACTS_PATH=app/ml/models

# === AI (GLM) ===
AI_PROVIDER=glm
AI_MODEL=glm-4.5-flash
AI_FALLBACK_MODEL=glm-4.5-flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=your-glm-api-key
AI_REQUEST_TIMEOUT_SECONDS=60

# === FRONTEND (Vite) ===
VITE_API_BASE_URL=http://localhost:8000
